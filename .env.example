# Copy to .env for local development. Never commit real values.

# --- Required ---
# `npm run dev:db` starts a throwaway MongoDB on port 27017 if you have none.
MONGODB_URI=mongodb://127.0.0.1:27017/it_ticketing
PORT=5000
NODE_ENV=development
# Signs bearer tokens. Required when NODE_ENV=production.
AUTH_SECRET=replace-with-a-long-random-secret

# --- Optional ---
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Origins allowed to call the API from a browser (comma separated). Unset = same-origin only.
CORS_ORIGINS=
# pino log level: trace, debug, info, warn, error or silent.
LOG_LEVEL=info
# Failed sign-ins allowed per window (default 10 per 15 minutes).
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=
# Reverse-proxy hops to trust for the client address. Leave unset unless behind a proxy.
TRUST_PROXY=
# Set to "off" to hide /api/docs and /api/openapi.json.
API_DOCS=

# --- Live smoke tests (only for a resettable, non-production environment) ---
LIVE_BASE_URL=http://127.0.0.1:5000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TECH_EMAIL=
E2E_TECH_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
LIVE_SMOKE_ENABLED=false
