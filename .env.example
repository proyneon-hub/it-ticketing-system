# Copy to .env for local development. Never commit real values.

# --- Required ---
# `npm run dev:db` starts a throwaway MongoDB on port 27017 if you have none.
MONGODB_URI=mongodb://127.0.0.1:27017/it_ticketing
PORT=5000
NODE_ENV=development
# Signs bearer tokens. Required when NODE_ENV=production.
# 32+ characters. Required when NODE_ENV=production. Generate one: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret
# The refresh cookie is Secure (https only) in production. Set false only for plain-http local runs.
# COOKIE_SECURE=false
# Refresh-token lifetime in days (default 7), and optional audit-log retention in days (default: keep forever).
# REFRESH_TOKEN_TTL_DAYS=7
# AUDIT_RETENTION_DAYS=90
# Set to off to stop creating the demo accounts on first sign-in.
# DEMO_USERS=off

# --- Optional ---
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Origins allowed to call the API from a browser (comma separated). Unset = same-origin only.
CORS_ORIGINS=
# pino log level: trace, debug, info, warn, error or silent.
LOG_LEVEL=info
# Failed sign-ins allowed per window (default 10 per 15 minutes).
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=
# Reverse-proxy hops to trust for the client address. Leave unset unless behind a proxy.
TRUST_PROXY=
# Set to "off" to hide /api/docs and /api/openapi.json.
API_DOCS=

# --- Scheduled jobs and notifications (both optional) ---
# Lets a scheduler call POST /api/jobs/sla-escalation and /api/jobs/outbox-delivery with
# "Authorization: Bearer <this>". 32+ characters. Unset, the jobs answer 503.
# CRON_SECRET=
# A Discord or Slack incoming-webhook URL (or any endpoint that accepts a JSON POST) to be told
# about new tickets, assignments, status changes, comments and SLA risk. The URL is a credential.
# Unset, no events are recorded and nothing is sent.
# WEBHOOK_URL=
# discord, slack or json. Chosen from the address when unset.
# WEBHOOK_FORMAT=
# How often `npm run worker` (or the Compose worker) runs both jobs, and how long delivered events are kept.
# WORKER_INTERVAL_MS=30000
# OUTBOX_RETENTION_DAYS=14

# --- Live smoke tests (only for a resettable, non-production environment) ---
LIVE_BASE_URL=http://127.0.0.1:5000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_TECH_EMAIL=
E2E_TECH_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
LIVE_SMOKE_ENABLED=false
