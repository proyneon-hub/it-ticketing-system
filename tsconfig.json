{
  // What `npm run typecheck` checks for the server: the build inputs plus the tests.
  // The Playwright suite has its own config (tsconfig.playwright.json).
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "server.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/seed.ts",
    "scripts/seed-kb.ts",
    "scripts/sync-indexes.ts",
    "scripts/eval.ts",
    "scripts/eval-retrieval.ts",
    "scripts/eval/**/*.ts"
  ],
  "exclude": []
}
