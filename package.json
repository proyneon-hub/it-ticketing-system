{
  "name": "it-ticketing-system",
  "version": "2.0.0",
  "description": "Full-stack IT ticketing system using Node.js, Express, MongoDB, React, and Vite.",
  "author": "Pramit Roy",
  "license": "MIT",
  "homepage": "https://pramitroy.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proyneon-hub/it-ticketing-system.git"
  },
  "bugs": {
    "url": "https://github.com/proyneon-hub/it-ticketing-system/issues"
  },
  "main": "dist-server/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "npm run dev:client",
    "dev:api": "tsx watch server.ts",
    "dev:client": "concurrently -k \"npm run dev:api\" \"npm run dev:vite\"",
    "dev:vite": "vite --host 0.0.0.0",
    "dev:db": "node scripts/dev-mongo.js",
    "start": "node --enable-source-maps dist-server/server.js",
    "build": "npm run build:client && npm run build:server",
    "test": "npm run test:api && npm run test:unit",
    "test:api": "vitest run -c vitest.server.config.mjs",
    "test:api:coverage": "vitest run -c vitest.server.config.mjs --coverage",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage": "npm run test:api:coverage && npm run test:unit:coverage",
    "test:e2e": "playwright test tests/e2e-mocked",
    "test:e2e:headed": "playwright test tests/e2e-mocked --headed",
    "test:e2e:ui": "playwright test tests/e2e-mocked --ui",
    "test:e2e:debug": "playwright test tests/e2e-mocked --debug",
    "screenshots:portfolio": "playwright test tests/visual/capture-portfolio-screenshots.spec.ts --project=chromium",
    "screenshots:demo": "playwright test tests/visual/capture-demo-frames.spec.ts --project=chromium",
    "test:all:playwright": "playwright test",
    "test:smoke:live": "playwright test -c playwright.live.config.ts",
    "test:a11y": "playwright test tests/accessibility",
    "typecheck:playwright": "tsc -p tsconfig.playwright.json",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"*.{js,mjs,ts,json,md,yml,yaml,html,css}\" \".github/**/*.{md,yml,yaml}\" \"api/**/*.js\" \"docs/**/*.md\" \"scripts/**/*.{js,ts}\" \"perf/**/*.js\" \"src/**/*.{js,jsx,ts,css}\" \"tests/**/*.{js,ts}\" \".prettierrc\" --write",
    "format:check": "prettier \"*.{js,mjs,ts,json,md,yml,yaml,html,css}\" \".github/**/*.{md,yml,yaml}\" \"api/**/*.js\" \"docs/**/*.md\" \"scripts/**/*.{js,ts}\" \"perf/**/*.js\" \"src/**/*.{js,jsx,ts,css}\" \"tests/**/*.{js,ts}\" \".prettierrc\" --check",
    "preview": "vite preview --host 0.0.0.0",
    "free:api-port": "powershell -ExecutionPolicy Bypass -File scripts/free-api-port.ps1",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "test:api:unit": "vitest run -c vitest.server.config.mjs --project unit",
    "test:integration": "vitest run -c vitest.server.config.mjs --project integration",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.playwright.json",
    "perf": "k6 run perf/load.js",
    "db:sync-indexes": "tsx scripts/sync-indexes.ts",
    "kb:seed": "tsx scripts/seed-kb.ts"
  },
  "keywords": [
    "it-ticketing",
    "helpdesk",
    "service-desk",
    "react",
    "express",
    "mongodb",
    "playwright",
    "typescript",
    "qa-automation",
    "e2e-testing",
    "accessibility-testing",
    "github-actions"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@tanstack/react-query": "^5.103.2",
    "@vercel/functions": "^3.9.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^8.9.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.4",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6",
      "disablePostinstall": "1"
    }
  }
}
